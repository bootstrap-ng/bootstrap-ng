{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "d7aad69a-1e24-4e1d-86ac-cdb1cac178f1"
  },
  "newProjectRoot": "projects",
  "projects": {
    "bootstrap-ng": {
      "projectType": "library",
      "root": "projects/bootstrap-ng",
      "sourceRoot": "projects/bootstrap-ng/src",
      "prefix": "bs",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/bootstrap-ng/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/bootstrap-ng/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/bootstrap-ng/tsconfig.spec.json",
            "browsers": ["chromiumHeadless"],
            "coverageReporters": ["text-summary", "html", "lcov"],
            "coverageThresholds": {
              "statements": 93,
              "branches": 88,
              "functions": 92,
              "lines": 93
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/bootstrap-ng/**/*.ts", "projects/bootstrap-ng/**/*.html"]
          }
        }
      }
    },
    "docs": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/docs",
      "sourceRoot": "projects/docs/src",
      "prefix": "docs",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/docs/src/main.ts",
            "server": "projects/docs/src/main.server.ts",
            "outputMode": "static",
            "tsConfig": "projects/docs/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "externalDependencies": ["img/bg.svg"],
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/docs/public"
              }
            ],
            "styles": ["projects/docs/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "vendor": false
              },
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "docs:build:production"
            },
            "development": {
              "buildTarget": "docs:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/docs/**/*.ts", "projects/docs/**/*.html"]
          }
        }
      }
    }
  }
}
