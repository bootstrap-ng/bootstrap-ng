{
  "name": "bootstrap-ng",
  "version": "6.0.0-alpha.1",
  "description": "Angular components for Bootstrap 6, built with signals.",
  "homepage": "https://bootstrap-ng.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bootstrap-ng/bootstrap-ng.git"
  },
  "bugs": {
    "url": "https://github.com/bootstrap-ng/bootstrap-ng/issues"
  },
  "funding": {
    "type": "PayPal",
    "url": "https://paypal.me/coliff"
  },
  "author": "bootstrap-ng",
  "scripts": {
    "ng": "ng",
    "start": "ng serve docs",
    "build": "ng build bootstrap-ng && npm run build:docs",
    "build:lib": "ng build bootstrap-ng",
    "build:docs": "ng build docs && npm run page-meta && npm run search-index && npm run llms-txt && npm run llms-full-txt && npm run sitemap && npm run 404-page",
    "404-page": "node -e \"require('node:fs').copyFileSync('dist/docs/browser/index.csr.html', 'dist/docs/browser/404.html')\"",
    "page-meta": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/page-meta.mjs",
    "search-index": "pagefind --site dist/docs/browser",
    "llms-txt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/llms-txt.mjs",
    "llms-full-txt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/llms-full-txt.mjs",
    "sitemap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sitemap.mjs",
    "pa11y": "npx pa11y https://bootstrap-ng.com/",
    "watch": "ng build bootstrap-ng --watch --configuration development",
    "test": "ng test bootstrap-ng --watch=false",
    "test:coverage": "ng test bootstrap-ng --watch=false --coverage",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@playwright/test": "^1.64.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "bootstrap": "6.0.0-alpha.1",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "ng-packagr": "^22.2.4",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "playwright": "^1.64.0",
    "prettier": "3.9.10",
    "shiki": "^4.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.23.3 || ^24.15.0 || >=26.0.0"
  },
  "volta": {
    "node": "22.23.3"
  }
}
